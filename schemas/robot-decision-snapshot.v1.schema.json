{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basementboys.org/schemas/robot-decision-snapshot.v1.schema.json",
  "title": "Basement Boys Robot Decision Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "snapshotId", "publishedAt", "source", "profiles", "records", "fingerprint"],
  "properties": {
    "format": { "const": "basement-boys/robot-decision-snapshot/v1" },
    "snapshotId": { "type": "string", "minLength": 8 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "kind", "authoritative", "privacy"],
      "properties": {
        "adapterId": { "type": "string", "minLength": 3 },
        "kind": { "enum": ["local-static", "readonly-http-proxy"] },
        "authoritative": { "type": "boolean" },
        "privacy": { "const": "catalog-only-no-scenario-upload" }
      }
    },
    "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "robot-profile.v1.schema.json" } },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "robot-decision-catalog.v1.schema.json" } },
    "fingerprint": { "type": "string", "pattern": "^fnv1a64-[0-9a-f]{16}$" }
  }
}
