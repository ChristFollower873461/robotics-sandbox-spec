{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basementboys.org/schemas/robot-profile.v1.schema.json",
  "title": "Basement Boys Robot Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "topology",
    "systemType",
    "recordStatus",
    "model",
    "company",
    "country",
    "countryCode",
    "region",
    "openScope",
    "license",
    "sourceUrl",
    "productUrl",
    "sourceReach",
    "geometryTruth",
    "geometryStatus",
    "sourceCheckedAt",
    "sources",
    "publishedClaims",
    "linkLengths",
    "jointsDegrees",
    "target",
    "elbow",
    "visual",
    "obstacles",
    "waypoints"
  ],
  "properties": {
    "format": {
      "const": "basement-boys/robot-profile/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "topology": {
      "enum": ["single", "dual"]
    },
    "systemType": {
      "enum": ["single-arm", "published-dual", "composed-pair"]
    },
    "recordStatus": {
      "enum": ["draft", "reviewed", "deprecated"]
    },
    "dualStatus": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "minLength": 2
    },
    "company": {
      "type": "string",
      "minLength": 2
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "region": {
      "enum": ["AMERICAN", "EUROPEAN"]
    },
    "openScope": {
      "type": "string",
      "minLength": 10
    },
    "license": {
      "type": "string",
      "minLength": 2
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "productUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sourceReach": {
      "type": "string",
      "minLength": 2
    },
    "geometryTruth": {
      "type": "string",
      "minLength": 10
    },
    "geometryStatus": {
      "enum": [
        "vendor-cad",
        "source-dimensioned",
        "normalized",
        "inferred",
        "unverified"
      ]
    },
    "sourceCheckedAt": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "publishedClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "baseSeparation": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "linkLengths": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false
    },
    "jointsDegrees": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "target": {
      "$ref": "#/$defs/point"
    },
    "elbow": {
      "enum": ["up", "down"]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "primary", "secondary", "shell"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/point"
          },
          {
            "type": "object",
            "required": ["id", "label"]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "topology": {
            "const": "dual"
          }
        }
      },
      "then": {
        "required": ["baseSeparation"]
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "kind", "label", "url"],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "source-repository",
            "manufacturer-product",
            "manufacturer-specification",
            "manufacturer-about"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "label", "value", "status", "sourceIds"],
      "properties": {
        "claimId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "vendor-claimed",
            "independently-verified",
            "disputed",
            "superseded"
          ]
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
