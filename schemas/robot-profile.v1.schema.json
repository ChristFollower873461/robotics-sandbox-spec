{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basementboys.org/schemas/robot-profile.v1.schema.json",
  "title": "Basement Boys Robot Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "recordStatus",
    "platformClass",
    "mobilityType",
    "simulationSupport",
    "simulationEngine",
    "simulationNote",
    "opennessStatus",
    "originBasis",
    "supplyChainStatus",
    "availabilityStatus",
    "model",
    "company",
    "country",
    "countryCode",
    "region",
    "openScope",
    "license",
    "sourceUrl",
    "productUrl",
    "sourceReach",
    "geometryTruth",
    "geometryStatus",
    "sourceCheckedAt",
    "sources",
    "publishedClaims",
    "visual"
  ],
  "properties": {
    "format": {
      "const": "basement-boys/robot-profile/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "platformClass": {
      "enum": ["arm", "humanoid", "quadruped", "drone"]
    },
    "mobilityType": {
      "enum": [
        "fixed-base",
        "mobile-manipulator",
        "biped",
        "quadruped",
        "multirotor"
      ]
    },
    "simulationSupport": {
      "enum": ["interactive", "catalog-only"]
    },
    "simulationEngine": {
      "enum": ["planar-arm-v1", "locomotion-catalog", "flight-catalog"]
    },
    "simulationNote": {
      "type": "string",
      "minLength": 10
    },
    "opennessStatus": {
      "enum": [
        "open-component",
        "open-platform",
        "mixed-open-restricted",
        "source-available-restricted"
      ]
    },
    "originBasis": {
      "type": "string",
      "minLength": 10
    },
    "supplyChainStatus": {
      "enum": ["not-assessed", "mixed"]
    },
    "availabilityStatus": {
      "enum": [
        "commercial-product",
        "self-build",
        "research-release",
        "commercial-kit-discontinued"
      ]
    },
    "topology": {
      "enum": ["single", "dual"]
    },
    "systemType": {
      "enum": ["single-arm", "published-dual", "composed-pair"]
    },
    "recordStatus": {
      "enum": ["draft", "reviewed", "deprecated"]
    },
    "dualStatus": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "minLength": 2
    },
    "company": {
      "type": "string",
      "minLength": 2
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "region": {
      "enum": ["AMERICAN", "EUROPEAN"]
    },
    "openScope": {
      "type": "string",
      "minLength": 10
    },
    "license": {
      "type": "string",
      "minLength": 2
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "productUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sourceReach": {
      "type": "string",
      "minLength": 2
    },
    "geometryTruth": {
      "type": "string",
      "minLength": 10
    },
    "geometryStatus": {
      "enum": [
        "vendor-cad",
        "source-dimensioned",
        "normalized",
        "inferred",
        "unverified"
      ]
    },
    "sourceCheckedAt": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "publishedClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "baseSeparation": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "linkLengths": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false
    },
    "jointsDegrees": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "target": {
      "$ref": "#/$defs/point"
    },
    "elbow": {
      "enum": ["up", "down"]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "primary", "secondary", "shell"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/point"
          },
          {
            "type": "object",
            "required": ["id", "label"]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platformClass": {
            "const": "arm"
          }
        }
      },
      "then": {
        "properties": {
          "mobilityType": {
            "enum": ["fixed-base", "mobile-manipulator"]
          },
          "simulationSupport": {
            "const": "interactive"
          },
          "simulationEngine": {
            "const": "planar-arm-v1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platformClass": {
            "const": "humanoid"
          }
        }
      },
      "then": {
        "properties": {
          "mobilityType": {
            "const": "biped"
          },
          "simulationSupport": {
            "const": "catalog-only"
          },
          "simulationEngine": {
            "const": "locomotion-catalog"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platformClass": {
            "const": "quadruped"
          }
        }
      },
      "then": {
        "properties": {
          "mobilityType": {
            "const": "quadruped"
          },
          "simulationSupport": {
            "const": "catalog-only"
          },
          "simulationEngine": {
            "const": "locomotion-catalog"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platformClass": {
            "const": "drone"
          }
        }
      },
      "then": {
        "properties": {
          "mobilityType": {
            "const": "multirotor"
          },
          "simulationSupport": {
            "const": "catalog-only"
          },
          "simulationEngine": {
            "const": "flight-catalog"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "simulationSupport": {
            "const": "interactive"
          }
        }
      },
      "then": {
        "required": [
          "topology",
          "systemType",
          "linkLengths",
          "jointsDegrees",
          "target",
          "elbow",
          "obstacles",
          "waypoints"
        ],
        "properties": {
          "platformClass": {
            "const": "arm"
          },
          "simulationEngine": {
            "const": "planar-arm-v1"
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["topology"] },
            { "required": ["systemType"] },
            { "required": ["baseSeparation"] },
            { "required": ["linkLengths"] },
            { "required": ["jointsDegrees"] },
            { "required": ["target"] },
            { "required": ["elbow"] },
            { "required": ["obstacles"] },
            { "required": ["waypoints"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "topology": {
            "const": "dual"
          }
        },
        "required": ["topology"]
      },
      "then": {
        "required": ["baseSeparation"]
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "kind", "label", "url"],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "source-repository",
            "project-documentation",
            "research-paper",
            "manufacturer-product",
            "manufacturer-specification",
            "manufacturer-about"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "label", "value", "status", "sourceIds"],
      "properties": {
        "claimId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "vendor-claimed",
            "independently-verified",
            "disputed",
            "superseded"
          ]
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
