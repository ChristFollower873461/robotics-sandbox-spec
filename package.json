{
  "name": "robotics-sandbox-spec",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Source-backed robot decision workbench, rough simulator, and guarded planar-arm teaching lab.",
  "scripts": {
    "assets:social": "node scripts/generate-social-assets.mjs",
    "build": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy --config dist/server/wrangler.json --domain robotics.basementboys.org",
    "start": "node scripts/dev-server.mjs",
    "dev": "node scripts/dev-server.mjs",
    "inspect": "node scripts/inspect-core.mjs",
    "inspect:json": "node scripts/inspect-core.mjs --json",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run inspect && npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "sharp": "0.35.2",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.185.1",
    "urdf-loader": "0.13.1"
  }
}
